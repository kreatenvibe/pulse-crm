generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id                    String         @id
  name                  String
  email                 String         @unique
  avatar                String?
  role                  String
  is_active             Boolean
  created_at            DateTime       @default(now()) @db.Timestamptz(6)
  updated_at            DateTime       @default(now()) @db.Timestamptz(6)
  performed_activities  activities[]
  assigned_appointments appointments[]
  assigned_customers    customers[]
  assigned_leads        leads[]
  authored_notes        notes[]
  assigned_tasks        tasks[]
}

model leads {
  id                String         @id
  name              String
  email             String?
  phone             String
  status            String
  source            String
  priority          String
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @db.Timestamptz(6)
  company           String?
  message           String?
  tags              String[]       @default([])
  assigned_to       String
  last_contacted_at DateTime?      @db.Timestamptz(6)
  appointments      appointments[]
  customer          customers?
  assignee          users          @relation(fields: [assigned_to], references: [id], onUpdate: Restrict)
  tasks             tasks[]

  @@index([assigned_to])
  @@index([status])
}

model customers {
  id               String         @id
  lead_id          String         @unique
  business_name    String?
  primary_contact  String
  phone            String
  email            String?
  address          String?
  assigned_to      String
  lifecycle_status String
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)
  appointments     appointments[]
  assignee         users          @relation(fields: [assigned_to], references: [id], onUpdate: Restrict)
  lead             leads          @relation(fields: [lead_id], references: [id], onUpdate: Restrict)
  invoices         invoices[]
  services         services[]
  tasks            tasks[]

  @@index([assigned_to])
}

model appointments {
  id          String     @id
  lead_id     String?
  customer_id String?
  title       String
  starts_at   DateTime   @db.Timestamptz(6)
  ends_at     DateTime   @db.Timestamptz(6)
  status      String
  assigned_to String
  notes       String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  assignee    users      @relation(fields: [assigned_to], references: [id], onUpdate: Restrict)
  customer    customers? @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lead        leads?     @relation(fields: [lead_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([lead_id])
  @@index([customer_id])
  @@index([assigned_to])
}

model tasks {
  id          String     @id
  title       String
  description String?
  assigned_to String
  lead_id     String?
  customer_id String?
  due_date    DateTime   @db.Timestamptz(6)
  priority    String
  status      String
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  assignee    users      @relation(fields: [assigned_to], references: [id], onUpdate: Restrict)
  customer    customers? @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lead        leads?     @relation(fields: [lead_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([assigned_to])
  @@index([lead_id])
  @@index([customer_id])
}

model services {
  id             String     @id
  customer_id    String
  title          String
  description    String?
  status         String
  scheduled_date DateTime?  @db.Timestamptz(6)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime   @default(now()) @db.Timestamptz(6)
  invoices       invoices[]
  customer       customers  @relation(fields: [customer_id], references: [id], onUpdate: Restrict)

  @@index([customer_id])
}

model invoices {
  id             String    @id
  customer_id    String
  service_id     String?
  amount_cents   BigInt
  currency       String
  invoice_number String    @unique
  status         String
  issued_at      DateTime  @db.Timestamptz(6)
  due_date       DateTime  @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  customer       customers @relation(fields: [customer_id], references: [id], onUpdate: Restrict)
  service        services? @relation(fields: [service_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([customer_id])
  @@index([service_id])
}

model activities {
  id           String   @id
  entity_type  String
  entity_id    String
  type         String
  description  String
  performed_by String
  occurred_at  DateTime @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  performer    users    @relation(fields: [performed_by], references: [id], onUpdate: Restrict)

  @@index([performed_by])
  @@index([entity_type, entity_id], map: "activities_entity_idx")
}

model notes {
  id          String   @id
  entity_type String
  entity_id   String
  content     String
  created_by  String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  author      users    @relation(fields: [created_by], references: [id], onUpdate: Restrict)

  @@index([created_by])
  @@index([entity_type, entity_id], map: "notes_entity_idx")
}
